<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pjmhub.queue-snapshot</string>

    <!-- Run the PJM interconnection-queue snapshot once a day. PJM only serves
         the current queue state, so this archives a dated snapshot each day to
         build the change-over-time history even when the app isn't opened. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/michaelbarry/Documents/GitHub/pjm-suite/PJM_Data_Hub/.venv/bin/python</string>
        <string>/Users/michaelbarry/Documents/GitHub/pjm-suite/PJM_Data_Hub/orchestrate.py</string>
        <string>update</string>
        <string>queue</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/michaelbarry/Documents/GitHub/pjm-suite/PJM_Data_Hub</string>

    <!-- Run roughly once a day, catching up on wake. Unlike a fixed clock
         time, StartInterval fires the job shortly after the Mac wakes if the
         24h interval elapsed while it was asleep. RunAtLoad also fires it once
         at login. Same-day snapshots dedup/replace, so an extra run is
         harmless. -->
    <key>StartInterval</key>
    <integer>86400</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/michaelbarry/Documents/GitHub/pjm-suite/PJM_Data_Hub/logs/queue_snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/michaelbarry/Documents/GitHub/pjm-suite/PJM_Data_Hub/logs/queue_snapshot.log</string>
</dict>
</plist>
